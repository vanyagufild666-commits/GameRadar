# Токен бота от @BotFather — обязателен
BOT_TOKEN=

# Имя SQLite-базы (по умолчанию bot.db в каталоге проекта)
DB_PATH=bot.db

# ID администраторов через запятую (для жалоб и банов) — опционально
ADMIN_IDS=

# @username бота без собаки — из него собираются ссылки-приглашения (/start=share)
BOT_USERNAME=Radar_GamerBot

# Заготовки под продвижение — опционально
CHANNEL_LINK=
CONTACT_LINK=
